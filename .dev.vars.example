# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Optional outbound providers.
# In production, set this with: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=re_your_resend_api_key
# In production, set this with: npx wrangler secret put BREVO_API_KEY
BREVO_API_KEY=xkeysib-your_brevo_api_key
# In production, set this with: npx wrangler secret put SMTP2GO_API_KEY
SMTP2GO_API_KEY=your_smtp2go_api_key
DEFAULT_OUTBOUND_PROVIDER=resend
OUTBOUND_PROVIDER_BY_DOMAIN=quanghuylee.cyou:resend,lequanghuy.dev:smtp2go
